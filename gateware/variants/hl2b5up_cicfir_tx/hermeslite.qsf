set_global_assignment -name VERILOG_MACRO "BETA5=1"
set_global_assignment -name VERILOG_MACRO "USE_ALTSYNCRAM=1"
# One shared block does every receiver's second CIC stage, state in M9K.
set_global_assignment -name VERILOG_MACRO "CIC_SHARED=1"
# That block is cic_fir_shared: a second CIC to 960 kHz and a /5 FIR, for
# +-75 kHz free of aliases (cic_s2_shared alone gives about +-35 kHz).
set_global_assignment -name VERILOG_MACRO "CIC_FIR=1"
# One transmitter, upconverted by the receive side's sincos NCO and four
# multipliers instead of the CORDIC, with the TX CIC combs in one M9K. Both
# save logic, the scarce resource in this build.
set_global_assignment -name VERILOG_MACRO "TX_NCO=1"
set_global_assignment -name VERILOG_MACRO "TX_CIC_MEM=1"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY build
source ../../boards/hl2b5up/general.tcl
source ../../boards/hl2b5up/pins.tcl
source ../../boards/hl2b5up/veth_2p5.tcl
source ../../boards/hl2b5up/vlvds_2p5.tcl
source ../../boards/hl2b5up/configurable_io.tcl
source ../../boards/hl2b5up/location.tcl
source ../../boards/hl2b3to4/location_10rx.tcl
source ../../boards/hl2b5up/files.tcl
set_global_assignment -name VERILOG_FILE ../../rtl/radio_openhpsdr1/receiver_ciconly.v
set_global_assignment -name VERILOG_FILE ../../rtl/radio_openhpsdr1/cic_fir_shared.v

set_global_assignment -name VERILOG_FILE ./hermeslite.v
set_global_assignment -name TOP_LEVEL_ENTITY hermeslite
set_global_assignment -name SDC_FILE ../../boards/hl2b5up/timing.sdc

set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top
# Resolve rtl includes (clk_config.vh, cic_fir_coefs.vh)
set_global_assignment -name SEARCH_PATH ../../rtl
set_global_assignment -name SEARCH_PATH ../../rtl/radio_openhpsdr1
# Seeds 1 and 2 both meet timing (worst +0.043 ns, clock_txoutputfast, as in
# every build). Seed 1 leaves +0.259 ns on clock_153p6MHz and +0.822 ns on
# clock_ethtxintfast against seed 2's +0.264 and +0.441; +2.34 ns on
# clock_76p8MHz. 19,600 LEs (88%), 59/66 M9K, 76/132 multipliers.
set_global_assignment -name SEED 1
